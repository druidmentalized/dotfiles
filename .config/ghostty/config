# --- Appearance ---
theme = midnight-mint
background-opacity = 0.85
# background-blur = true
# window-decoration = false

# --- MacOS specific ---
macos-non-native-fullscreen = true
macos-option-as-alt = true

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-thicken=true
font-thicken-strength=1

# --- Window Layout ---
window-padding-x = 10
window-padding-y = 10

# --- Behavior ---
cursor-style = block
cursor-style-blink = true
copy-on-select = true

# --- Key Mappings ---
keybind = super+d=unbind
keybind = super+shift+d=unbind

# Option+\ sends ESC | (tmux M-| split); a literal ESC \ collides with ST ending terminal replies
keybind = alt+backslash=esc:|

# --- Shaders ---
custom-shader = ./shaders/cursor_warp.glsl
