# --- Appearance ---
theme = midnight-mint
background-opacity = 0.95
window-decoration = false

# --- MacOS specific ---
macos-non-native-fullscreen = true
macos-option-as-alt = true

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13

# --- Window Layout ---
window-padding-x = 10
window-padding-y = 10

# --- Behavior ---
cursor-style = block
cursor-style-blink = true
copy-on-select = true

# --- Key Mappings ---
