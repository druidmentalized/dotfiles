" ---------------------------------------------------------------------
"                        LEADER & GENERAL
" ---------------------------------------------------------------------
let mapleader = " "

" Match your Neovim clipboard behavior (System Sync)
" Note: Removed the syntax error (space after comma) you had before
set clipboard+=unnamedplus

" Standard Vim settings
set number
set relativenumber
set scrolloff=10
set incsearch
set hlsearch
set showcmd
set visualbell
set history=1000

" IntelliJ specific integrations
set ideajoin
set ideamarks
set idearefactormode=normal
set ideastatusicon=gray

" ---------------------------------------------------------------------
"                      NAVIGATION (Ctrl + hjkl)
" ---------------------------------------------------------------------
" Move between splits using the same keys as Neovim/Tmux
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ---------------------------------------------------------------------
"                  WINDOW SPLITS (Match LazyVim)
" ---------------------------------------------------------------------
" Vertical Split (Matches your <leader>\)
nnoremap <leader>\ :action SplitVertically<CR>

" Horizontal Split (Matches your <leader>-)
nnoremap <leader>- :action SplitHorizontally<CR>

" Close current split/tab (Matches LazyVim <leader>wd)
nnoremap <leader>wd :action CloseContent<CR>

" ---------------------------------------------------------------------
"                 SNACKS.PICKER REPLICAS (Finding)
" ---------------------------------------------------------------------
" <leader><leader> -> Search Everywhere (Matches LazyVim Smart Find)
nmap <leader><leader> <Action>(SearchEverywhere)

" <leader>ff -> Find Files (Root Dir)
nmap <leader>ff <Action>(GotoFile)

" <leader>fb -> Buffers (Recent Files)
nmap <leader>fb <Action>(RecentFiles)

" <leader>fr -> Recent Files
nmap <leader>fr <Action>(ManageRecentProjects)

" <leader>sg -> Grep / Find in Path
nmap <leader>sg <Action>(FindInPath)

" <leader>/ -> Grep (Alternative)
nmap <leader>/ <Action>(FindInPath)

" ---------------------------------------------------------------------
"                   EDITING & REFACTORING
" ---------------------------------------------------------------------
" Paste without overwriting register (Matches your new Neovim config)
vnoremap p "_dP

" Rename Symbol (Matches LazyVim <leader>cr)
nmap <leader>cr <Action>(RenameElement)

" Code Actions / Intentions (Matches LazyVim <leader>ca)
nmap <leader>ca <Action>(ShowIntentionActions)

" Go to Definition/Implementation
nmap gd <Action>(GotoDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(ShowUsages)

" ---------------------------------------------------------------------
"                        PLUGIN EMULATION
" ---------------------------------------------------------------------
set surround
set commentary
set easymotion
set highlightedyank
set matchit
set quickscope

" Nerdtree emulation (Maps to Project View)
set NERDTree
let g:NERDTreeMapActivateNode='l'
let g:NERDTreeMapJumpParent='h'

